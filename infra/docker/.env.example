# Dueproof self-hosted server: copy to .env next to compose.yaml and fill in.
# Generate each secret with:  openssl rand -hex 32
# Keep a copy of this file somewhere safe: backups don't include it.

# The name people type to reach Dueproof. Point its DNS A/AAAA record at this
# server and open ports 80 and 443; Caddy gets the certificate by itself.
# "localhost" works for a trial on one machine (Caddy's local CA).
DUEPROOF_DOMAIN=dueproof.example.in

# Required secrets (32+ characters each). Generate all four at once with:
#   for k in AUTH_SECRET ENGINE_SHARED_SECRET POSTGRES_PASSWORD CRON_SECRET; do
#     sed -i "s|^$k=.*|$k=$(openssl rand -hex 32)|" .env; done
AUTH_SECRET=
ENGINE_SHARED_SECRET=
POSTGRES_PASSWORD=
# Authorises the daily run (morning digest, notifications, escalation). The
# `daily` service calls the app with it every day at DAILY_AT.
CRON_SECRET=
# When the daily run happens, in TZ below (24-hour HH:MM).
# DAILY_AT=07:00

# Email: invitations, password reset links and the morning digest.
# Without these nothing is sent: invitation links can still be copied from
# Settings -> Team & access, but password reset emails and digests can't go out.
#   SMTP_URL   smtp://user:password@smtp.example.in:587 (URL-encode special characters)
#   MAIL_FROM  the sender people see
# MAIL_DRIVER is picked from what you set (resend, then smtp, else log = send nothing).
# SMTP_URL=
# MAIL_FROM=Dueproof <dueproof@your-firm.in>
# MAIL_DRIVER=smtp
# RESEND_API_KEY=

# Encrypts each organisation's own AI provider key (Settings -> AI, "Your own key").
# 32 random bytes, base64:  openssl rand -base64 32
# Unset: a key can't be saved. Keep a copy: without it saved keys can't be read.
# AI_KEY_MASTER=

# Web Push (phone and desktop alerts). Unset: a key pair derived from AUTH_SECRET,
# which is fine. To set your own pair (base64url, P-256):
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A contact for push services: mailto:admin@your-firm.in or the app's address.
# VAPID_SUBJECT=

# Version tag of the images (also used when building from source).
DUEPROOF_VERSION=0.1.0
# DUEPROOF_APP_IMAGE=dueproof/app
# DUEPROOF_ENGINE_IMAGE=dueproof/engine

# first-user: the first sign-up owns the organisation, then invitations only.
# AUTH_SIGNUP=first-user

# Engine image options (build time).
#   ENGINE_INSTALL_TRANSLATION=0  leaves out torch + IndicTrans2 (a much smaller image, no offline translation)
#   ENGINE_INSTALL_TESSERACT=0    leaves out Tesseract too (text layer + PaddleOCR only)
# ENGINE_INSTALL_TRANSLATION=1
# ENGINE_INSTALL_TESSERACT=1
# ENGINE_OCR_PACKS=tesseract-ocr-hin tesseract-ocr-mal tesseract-ocr-tam
# Folder with the IndicTrans2 weights (docs/install.md, "Offline translation").
# INDICTRANS2_DIR=./indictrans2
# ENGINE_MEMORY=6g
# Highest OCR rung: text_layer | paddleocr | tesseract
# ENGINE_MAX_RUNG=tesseract

# Backups (docs/backup-and-restore.md). The app reads BACKUP_DIR/last.json
# (read-only) to show the last backup in Settings -> System.
# BACKUP_DIR=./backups
# BACKUP_AT=02:30
# BACKUP_KEEP_DAYS=14
# Time zone for backups and the daily run.
# TZ=Asia/Kolkata

# Per-file upload cap in bytes (50 MB).
# UPLOAD_MAX_BYTES=52428800
# Rate limit overrides, e.g. upload.user=100/1h,search.user=60/1m
# RATE_LIMITS=
# Token for scraping /api/metrics from another machine (otherwise local only).
# METRICS_TOKEN=
# Parallel workflow steps.
# WORKFLOW_CONCURRENCY=8

# Ports Caddy listens on.
# HTTP_PORT=80
# HTTPS_PORT=443
