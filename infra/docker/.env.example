# Dueproof self-hosted server: copy to .env next to compose.yaml and fill in.
# Generate each secret with:  openssl rand -hex 32
# Keep a copy of this file somewhere safe: backups don't include it.

# The name people type to reach Dueproof. Point its DNS A/AAAA record at this
# server and open ports 80 and 443; Caddy gets the certificate by itself.
# "localhost" works for a trial on one machine (Caddy's local CA).
DUEPROOF_DOMAIN=dueproof.example.in

# Required secrets (32+ characters each).
AUTH_SECRET=
ENGINE_SHARED_SECRET=
POSTGRES_PASSWORD=

# Version tag of the images (also used when building from source).
DUEPROOF_VERSION=0.1.0
# DUEPROOF_APP_IMAGE=dueproof/app
# DUEPROOF_ENGINE_IMAGE=dueproof/engine

# first-user: the first sign-up owns the organisation, then invitations only.
# AUTH_SIGNUP=first-user

# Engine image options (build time).
#   ENGINE_INSTALL_TRANSLATION=0  leaves out torch + IndicTrans2 (a much smaller image, no offline translation)
#   ENGINE_INSTALL_TESSERACT=0    leaves out Tesseract too (text layer + PaddleOCR only)
# ENGINE_INSTALL_TRANSLATION=1
# ENGINE_INSTALL_TESSERACT=1
# ENGINE_OCR_PACKS=tesseract-ocr-hin tesseract-ocr-mal tesseract-ocr-tam
# Folder with the IndicTrans2 weights (docs/install.md, "Offline translation").
# INDICTRANS2_DIR=./indictrans2
# ENGINE_MEMORY=6g
# Highest OCR rung: text_layer | paddleocr | tesseract
# ENGINE_MAX_RUNG=tesseract

# Backups (docs/backup-and-restore.md).
# BACKUP_DIR=./backups
# BACKUP_AT=02:30
# BACKUP_KEEP_DAYS=14
# TZ=Asia/Kolkata

# Per-file upload cap in bytes (50 MB).
# UPLOAD_MAX_BYTES=52428800
# Rate limit overrides, e.g. upload.user=100/1h,search.user=60/1m
# RATE_LIMITS=
# Token for scraping /api/metrics from another machine (otherwise local only).
# METRICS_TOKEN=
# Parallel workflow steps.
# WORKFLOW_CONCURRENCY=8

# Ports Caddy listens on.
# HTTP_PORT=80
# HTTPS_PORT=443
