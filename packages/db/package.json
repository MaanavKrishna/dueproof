{
  "name": "@dueproof/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/embed-migrations.mjs --check && vitest run",
    "db:generate": "drizzle-kit generate && biome format --write migrations/meta && node scripts/embed-migrations.mjs",
    "db:check": "node scripts/embed-migrations.mjs --check",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@dueproof/contracts": "workspace:*",
    "@electric-sql/pglite": "0.5.16",
    "@neondatabase/serverless": "1.2.1",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
