{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "**",
      "!.next",
      "!.data",
      "!node_modules",
      "!app/.well-known/workflow",
      "!test-results"
    ]
  },
  "linter": { "domains": { "playwright": "none" } },
  "overrides": [
    { "includes": ["e2e/**"], "linter": { "domains": { "playwright": "recommended" } } }
  ]
}
