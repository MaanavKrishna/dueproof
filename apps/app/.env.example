# Dueproof app — copy to .env.local for development. Every value is read and
# validated at boot (lib/env.ts). Nothing here may be NEXT_PUBLIC_.

# self-hosted | hosted | desktop
DUEPROOF_EDITION=self-hosted
APP_URL=http://localhost:3000

# 32+ random characters: `openssl rand -hex 32`
AUTH_SECRET=
# first-user (default for self-hosted/desktop) | open (default for hosted)
# AUTH_SIGNUP=first-user
# AUTH_TRUSTED_ORIGINS=tauri://localhost
# AUTH_IP_HEADER=x-forwarded-for

# Database: pglite (default, embedded) | postgres | neon
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://dueproof:dueproof@localhost:5432/dueproof
# Under `next dev`, keep PGLITE_DATA_DIR and STORAGE_LOCAL_DIR outside the
# repository (e.g. $HOME/.dueproof-dev/pglite): Turbopack watches the repo, and
# every database write under it triggers a full page reload (a reload loop).
PGLITE_DATA_DIR=.data/pglite
DB_MIGRATE_ON_START=1

# Storage: local (default) | s3 (Cloudflare R2, MinIO) | vercel-blob (stub)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/files
# STORAGE_SIGNING_SECRET=   (defaults to a key derived from AUTH_SECRET)
# STORAGE_ENGINE_BASE_URL=http://app:3000   (how the engine container reaches this app)
# S3_BUCKET=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=0

# Engine: fake (default without ENGINE_URL; recordings, dev only) | http
# ENGINE_MODE=http
# ENGINE_URL=http://localhost:8000
# ENGINE_SHARED_SECRET=   (32+ characters, same value in services/engine)
# ENGINE_MAX_RUNG=tesseract

# UPLOAD_MAX_BYTES=52428800

# Workflow DevKit: the Local World is the default in development.
# Self-hosted servers use the Postgres World:
# WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# WORKFLOW_POSTGRES_URL=postgres://dueproof:dueproof@localhost:5432/dueproof

# Hosted only: engine-heavy in Vercel Sandbox (infra/sandbox/build-snapshot.ts).
# Needs STORAGE_DRIVER=s3. Unset = no escalation past engine-fast, no offline translation.
# HEAVY_ENGINE_SNAPSHOT_ID=
# HEAVY_ENGINE_REGION=bom1
# HEAVY_ENGINE_VCPUS=4
# HEAVY_ENGINE_TIMEOUT_MS=900000
# HEAVY_ENGINE_ALLOWED_HOSTS=   (default: the storage host only)

# AI (planning/v0.1/04-ai.md). Settings → AI chooses the mode per organisation.
# AI_KEY_MASTER wraps BYOK keys at rest: 32 random bytes, base64
# (openssl rand -base64 32). Keep it out of backups of the database.
# AI_KEY_MASTER=
# Hosted plan only: Dueproof's own Claude API key (the plan calls the
# Claude API directly).
# ANTHROPIC_API_KEY=
# Optional alternative plan path through Vercel AI Gateway.
# AI_GATEWAY_API_KEY=

# Bearer token for /api/metrics from another machine (otherwise loopback only).
# METRICS_TOKEN=
# Rate limits (Postgres-backed). Overrides: name=count/window, e.g.
# RATE_LIMITS=upload.user=100/1h,search.user=60/1m
# RATE_LIMIT_ENABLED=1

# DUEPROOF_DEV_PAGES=1
