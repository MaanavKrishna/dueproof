# Dependencies and environments
node_modules/
.venv/
__pycache__/
*.pyc
*.egg-info/

# Build output and caches
.next/
.turbo/
out/
build/
dist/
storybook-static/
*.tsbuildinfo
.swc/

# Test output
coverage/
playwright-report/
test-results/

# Local data
pgdata/

# Environment files: only the examples are committed
.env
.env.*
!.env.example

# Logs, editor and OS files
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local agent state
.claude/
.playwright-mcp/

# Licence signing keys (ee/licence): never commit a real private key. The
# only private keys in the repository are the marked TEST keys.
*.private.pem
*.pkcs8
licence-keys/
!ee/licence/test-keys/*.private.pem
!ee/sso/test-idp/*.private.pem
